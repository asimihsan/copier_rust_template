[tools]
"cargo:cargo-audit" = { version = "0.22.2", install_env = { RUSTC_WRAPPER = "" } }
"cargo:cargo-deny" = { version = "0.19.0", install_env = { RUSTC_WRAPPER = "" } }
"cargo:cargo-hack" = { version = "0.6.44", install_env = { RUSTC_WRAPPER = "" } }
"cargo:cargo-insta" = { version = "1.47.1", install_env = { RUSTC_WRAPPER = "" } }
"cargo:cargo-llvm-cov" = { version = "0.8.5", install_env = { RUSTC_WRAPPER = "" } }
"cargo:cargo-msrv" = { version = "0.19.3", install_env = { RUSTC_WRAPPER = "" } }
"cargo:cargo-nextest" = { version = "0.9.132", install_env = { RUSTC_WRAPPER = "" } }
"cargo:cargo-outdated" = { version = "0.17.0", install_env = { RUSTC_WRAPPER = "" } }
"cargo:cargo-watch" = { version = "8.5.3", install_env = { RUSTC_WRAPPER = "" } }
{%- if include_go %}
"cargo:cbindgen" = { version = "0.29.2", install_env = { RUSTC_WRAPPER = "" } }
{%- endif %}
{%- if include_web_leptos %}
"cargo:leptosfmt" = { version = "0.1.33", install_env = { RUSTC_WRAPPER = "" } }
{%- endif %}
{%- if include_wasm %}
"cargo:wasm-pack" = { version = "0.14.0", install_env = { RUSTC_WRAPPER = "" } }
{%- endif %}
{%- if include_go_wasm %}
"github:WebAssembly/wabt" = "1.0.40"
{%- endif %}
{%- if include_web_leptos %}
"github:tailwindlabs/tailwindcss" = "4.3.3"
"github:wasm-bindgen/wasm-bindgen" = "0.2.126"
{%- endif %}
actionlint = "1.7.11"
ast-grep = "0.44.0"
bun = "1.3.11"
cargo-binstall = "1.17.9"
fd = "10.4.2"
"go:github.com/google/addlicense" = "1.2.0"
{%- if include_go or include_go_wasm %}
go = "1.26.1"
golangci-lint = "2.11.4"
{%- endif %}
{%- if include_uniffi_sdk %}
gradle = "9.6.1"
java = "corretto-21.0.11.10.1"
kotlin = "2.2.21"
# macOS uses Xcode's Swift compiler with its matching SDK.
swift = { version = "6.3.3", os = ["linux"] }
{%- endif %}
jq = "1.8.1"
python = "3.14.3"
"rust" = { version = "1.96.1", components = "rustfmt,clippy,llvm-tools,rust-src"{% if include_wasm or include_web_leptos or include_go_wasm %}, targets = "{% if include_wasm or include_web_leptos %}wasm32-unknown-unknown{% if include_go_wasm %},wasm32-wasip1{% endif %}{% elif include_go_wasm %}wasm32-wasip1{% endif %}"{% endif %} }
"github:kunobi-ninja/kache" = "0.8.0"
shellcheck = "0.11.0"
uv = "0.12.20"

[task_config]
includes = ["mise-tasks"]

[env]
LIBRARY_PATH = "${LIBRARY_PATH:-}:/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib:/opt/homebrew/opt/libiconv/lib"
MACOSX_DEPLOYMENT_TARGET = "11.0"
RUST_BACKTRACE = "1"
RUSTC_WRAPPER = "kache"
RUSTUP_TOOLCHAIN = "1.96.1"

[settings]
env_shell_expand = true
experimental = true
idiomatic_version_file_enable_tools = ["rust"]
{%- if include_uniffi_sdk %}
# The SDK supports GNU Linux and native macOS. Swift publishes no musl builds.
# Keep cross-platform locking independent of workstation or runner defaults.
lockfile_platforms = ["linux-arm64", "linux-x64", "macos-arm64", "macos-x64"]
{%- endif %}
