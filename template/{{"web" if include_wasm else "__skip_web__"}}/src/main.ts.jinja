import './style.css';
import init, { greet } from '../pkg/{{ project_slug_underscore }}_wasm.js';

document.querySelector<HTMLDivElement>('#app')!.innerHTML = `
  <div>
    <h1>{{ project_name }} WASM</h1>
    <div class="card">
      <input id="recipient" value="Ihsan" />
      <br>
      <button id="greet">Greet</button>
      <pre id="output"></pre>
    </div>
  </div>
`;

// Initialize WASM
init().then(() => {
    const greetButton = document.querySelector<HTMLButtonElement>('#greet')!;
    const recipient = document.querySelector<HTMLInputElement>('#recipient')!;
    const output = document.querySelector<HTMLPreElement>('#output')!;

    greetButton.addEventListener('click', () => {
        try {
            const result = greet(recipient.value);
            output.textContent = result;
        } catch (e) {
            output.textContent = `Error: ${e}`;
        }
    });
});
