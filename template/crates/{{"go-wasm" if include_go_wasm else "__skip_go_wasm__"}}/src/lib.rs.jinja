#![allow(unsafe_code)]
//! Go/WASI bindings for {{ project_name }}.

use {{ project_slug_underscore }}_core::greeting_message;
use std::time::{SystemTime, UNIX_EPOCH};

#[cfg(target_arch = "wasm32")]
#[global_allocator]
static ALLOCATOR: talc::wasm::WasmDynamicTalc = talc::wasm::new_wasm_dynamic_allocator();

/// Version of the WASM interface.
pub const VERSION: &str = "1.0.0";

/// Allocates memory that can be accessed from the host.
///
/// # Safety
///
/// The returned pointer must be freed using `deallocate` with the same size.
#[unsafe(no_mangle)]
pub unsafe extern "C" fn allocate(size: usize) -> *mut u8 {
    let Ok(layout) = std::alloc::Layout::from_size_align(size, 8) else {
        return std::ptr::null_mut();
    };

    unsafe { std::alloc::alloc(layout) }
}

/// Deallocates memory previously allocated with `allocate`.
///
/// # Safety
///
/// `ptr` must have been allocated by `allocate` with the same `size`.
#[unsafe(no_mangle)]
pub unsafe extern "C" fn deallocate(ptr: *mut u8, size: usize) {
    if ptr.is_null() {
        return;
    }

    let Ok(layout) = std::alloc::Layout::from_size_align(size, 8) else {
        return;
    };

    unsafe {
        std::alloc::dealloc(ptr, layout);
    }
}

fn write_host_string(message: &str) -> u64 {
    let bytes = message.as_bytes();
    let len = bytes.len();
    let ptr = unsafe { allocate(len) };

    if ptr.is_null() {
        return 0;
    }

    unsafe {
        std::ptr::copy_nonoverlapping(bytes.as_ptr(), ptr, len);
    }

    ((ptr as u64) << 32) | (len as u64)
}

/// Greet a recipient and return a pointer/length pair packed as a `u64`.
///
/// The high 32 bits contain the pointer and the low 32 bits contain the length.
/// The returned memory must be released by the caller with `deallocate`.
///
/// # Safety
///
/// `ptr` must point to `len` bytes of valid host memory.
#[unsafe(no_mangle)]
pub unsafe extern "C" fn greet_recipient(ptr: *const u8, len: usize) -> u64 {
    let input_bytes = unsafe { std::slice::from_raw_parts(ptr, len) };

    let message = match std::str::from_utf8(input_bytes) {
        Ok(recipient) => greeting_message(recipient).unwrap_or_else(|err| format!("Error: {err}")),
        Err(_) => "Error: invalid UTF-8 in input".to_string(),
    };

    write_host_string(&message)
}

/// Check whether a returned message is an error.
///
/// # Safety
///
/// The caller must ensure `ptr` and `len` identify memory returned by
/// `greet_recipient` that has not yet been freed.
#[unsafe(no_mangle)]
pub unsafe extern "C" fn is_greeting_error(ptr: *const u8, len: usize) -> i32 {
    if ptr.is_null() || len < 6 {
        return 0;
    }

    let slice = unsafe { std::slice::from_raw_parts(ptr, 6.min(len)) };
    i32::from(slice == b"Error:")
}

/// Get the current timestamp in milliseconds since the UNIX epoch.
#[unsafe(no_mangle)]
pub extern "C" fn get_timestamp_ms() -> u64 {
    SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .map_or(0, |duration| {
            u64::try_from(duration.as_millis()).unwrap_or(u64::MAX)
        })
}

#[cfg(target_arch = "wasm32")]
#[cfg(test)]
mod tests {
    use super::*;

    unsafe fn unpack_ptr_len(packed: u64) -> (*const u8, usize) {
        let ptr = (packed >> 32) as *const u8;
        let len = (packed & 0xFFFF_FFFF) as usize;
        (ptr, len)
    }

    unsafe fn read_string(ptr: *const u8, len: usize) -> String {
        let slice = unsafe { std::slice::from_raw_parts(ptr, len) };
        String::from_utf8_lossy(slice).to_string()
    }

    fn greet(input: &str) -> Result<String, String> {
        let input_bytes = input.as_bytes();
        unsafe {
            let result = greet_recipient(input_bytes.as_ptr(), input_bytes.len());
            if result == 0 {
                return Err("allocation error".to_string());
            }

            let (ptr, len) = unpack_ptr_len(result);
            let output = read_string(ptr, len);
            let is_error = is_greeting_error(ptr, len) != 0;
            deallocate(ptr as *mut u8, len);

            if is_error { Err(output) } else { Ok(output) }
        }
    }

    #[test]
    fn greets_recipient() {
        let greeting = greet("Ihsan").expect("greeting should succeed");
        assert_eq!(greeting, "Hello, Ihsan! Welcome to {{ project_name }}.");
    }

    #[test]
    fn rejects_empty_recipient() {
        let err = greet("").expect_err("empty recipient should fail");
        assert!(err.starts_with("Error:"));
    }

    #[test]
    fn timestamp_is_available() {
        assert!(get_timestamp_ms() > 0);
    }
}
