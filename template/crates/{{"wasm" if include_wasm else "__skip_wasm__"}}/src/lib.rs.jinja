//! WebAssembly bindings for {{ project_name }}.

use wasm_bindgen::prelude::*;

/// Creates a greeting from JavaScript.
///
/// This function takes a recipient and returns the rendered greeting message.
///
/// # Errors
///
/// Returns `Err(JsValue)` when the recipient is empty.
#[wasm_bindgen]
pub fn greet(recipient: &str) -> Result<JsValue, JsValue> {
    match {{ project_slug_underscore }}_core::greeting_message(recipient) {
        Ok(result) => Ok(JsValue::from_str(&result)),
        Err(err) => Err(JsValue::from_str(&err.to_string())),
    }
}
