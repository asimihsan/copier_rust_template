//! Core library for {{ project_name }}.
//!
//! This crate is the default place for domain behavior that should be shared by
//! binaries, bindings, and services.

use thiserror::Error;

/// A greeting created by the core domain.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Greeting {
    recipient: String,
    message: String,
}

impl Greeting {
    /// Returns the recipient that was used to create this greeting.
    pub fn recipient(&self) -> &str {
        &self.recipient
    }

    /// Returns the rendered greeting message.
    pub fn message(&self) -> &str {
        &self.message
    }

    /// Consumes the greeting and returns the rendered message.
    pub fn into_message(self) -> String {
        self.message
    }
}

/// Errors returned by greeting construction.
#[derive(Debug, Error, Clone, PartialEq, Eq)]
pub enum GreetingError {
    /// The supplied recipient was empty after trimming whitespace.
    #[error("recipient cannot be empty")]
    EmptyRecipient,
}

/// Creates a typed greeting for a recipient.
///
/// # Errors
///
/// Returns [`GreetingError::EmptyRecipient`] when `recipient` is empty after
/// trimming whitespace.
///
/// # Examples
///
/// ```
/// use {{ project_slug_underscore }}_core::create_greeting;
///
/// # fn main() -> Result<(), Box<dyn std::error::Error>> {
/// let greeting = create_greeting("Ihsan")?;
/// assert_eq!(greeting.message(), "Hello, Ihsan! Welcome to {{ project_name }}.");
/// # Ok(())
/// # }
/// ```
pub fn create_greeting(recipient: &str) -> Result<Greeting, GreetingError> {
    let recipient = recipient.trim();
    if recipient.is_empty() {
        return Err(GreetingError::EmptyRecipient);
    }

    let message = format!("Hello, {recipient}! Welcome to {{ project_name }}.");
    Ok(Greeting {
        recipient: recipient.to_owned(),
        message,
    })
}

/// Creates and renders a greeting message.
///
/// # Errors
///
/// Returns [`GreetingError::EmptyRecipient`] when `recipient` is empty after
/// trimming whitespace.
pub fn greeting_message(recipient: &str) -> Result<String, GreetingError> {
    create_greeting(recipient).map(Greeting::into_message)
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn greeting_preserves_trimmed_recipient() -> Result<(), GreetingError> {
        let greeting = create_greeting("  Ihsan  ")?;

        assert_eq!(greeting.recipient(), "Ihsan");
        assert_eq!(
            greeting.message(),
            "Hello, Ihsan! Welcome to {{ project_name }}."
        );

        Ok::<(), GreetingError>(())
    }

    #[test]
    fn empty_recipient_is_rejected() {
        let error = create_greeting("   ").unwrap_err();

        assert_eq!(error, GreetingError::EmptyRecipient);
    }
}
