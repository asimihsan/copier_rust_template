// Package binding provides Go bindings for {{ project_name }}.
package binding

/*
#cgo CFLAGS: -I${SRCDIR}/..
#cgo LDFLAGS: -L${SRCDIR}/../../target/debug -l{{ project_slug_underscore }}_go

#include "binding.h"
#include <stdlib.h>
*/
import "C"
import (
	"context"
	"fmt"
	"sync"
	"unsafe"
)

// Version of the binding package.
const Version = "1.0.0"

// Greeting represents a rendered greeting.
type Greeting struct {
	// Message contains the rendered greeting.
	Message string
	// Recipient contains the original requested recipient.
	Recipient string
}

// String returns the rendered greeting.
func (g *Greeting) String() string {
	return g.Message
}

// GreetingError represents an error from the Rust greeting facade.
type GreetingError struct {
	msg string
}

func (e *GreetingError) Error() string {
	return e.msg
}

// Greet creates a greeting with context support.
func Greet(ctx context.Context, recipient string) (*Greeting, error) {
	select {
	case <-ctx.Done():
		return nil, ctx.Err()
	default:
	}

	cInput := C.CString(recipient)
	defer C.free(unsafe.Pointer(cInput))

	cResult := C.greet_recipient(cInput)
	if cResult == nil {
		return nil, &GreetingError{msg: "null pointer returned from Rust"}
	}
	defer C.free_rust_string(cResult)

	result := C.GoString(cResult)
	if len(result) > 6 && result[:6] == "Error:" {
		return nil, &GreetingError{msg: result[7:]}
	}

	return &Greeting{Message: result, Recipient: recipient}, nil
}

// MustGreet is like Greet but panics on error.
func MustGreet(recipient string) *Greeting {
	greeting, err := Greet(context.Background(), recipient)
	if err != nil {
		panic(err)
	}
	return greeting
}

// GreetConcurrent greets multiple recipients concurrently.
func GreetConcurrent(ctx context.Context, recipients []string) ([]*Greeting, error) {
	var (
		wg       sync.WaitGroup
		mu       sync.Mutex
		results  = make([]*Greeting, len(recipients))
		errs     = make([]error, len(recipients))
	)

	for i, recipient := range recipients {
		wg.Add(1)
		go func(idx int, value string) {
			defer wg.Done()
			result, err := Greet(ctx, value)
			mu.Lock()
			results[idx] = result
			errs[idx] = err
			mu.Unlock()
		}(i, recipient)
	}

	wg.Wait()

	var errMsgs []string
	for i, err := range errs {
		if err != nil {
			errMsgs = append(errMsgs, fmt.Sprintf("input %d: %v", i, err))
		}
	}

	if len(errMsgs) > 0 {
		return results, &GreetingError{msg: fmt.Sprintf("multiple greeting errors: %v", errMsgs)}
	}

	return results, nil
}
