#![allow(unsafe_code)]
//! Go FFI bindings for {{ project_name }}.

use std::ffi::{CStr, CString};
use std::os::raw::c_char;

use {{ project_slug_underscore }}_core::greeting_message;

/// Version of the FFI interface.
pub const VERSION: &str = "1.0.0";

/// Exported FFI function to create a greeting.
///
/// # Safety
///
/// The caller must ensure:
/// * `input` is a valid pointer to a null-terminated C string
/// * the C string contains valid UTF-8 data
///
/// The returned string must be freed using [`free_rust_string`].
#[unsafe(no_mangle)]
pub unsafe extern "C" fn greet_recipient(input: *const c_char) -> *mut c_char {
    if input.is_null() {
        return CString::new("Error: null pointer provided")
            .unwrap_or_default()
            .into_raw();
    }

    let Ok(input_str) = unsafe { CStr::from_ptr(input) }.to_str() else {
        return CString::new("Error: invalid UTF-8 in input")
            .unwrap_or_default()
            .into_raw();
    };

    match greeting_message(input_str) {
        Ok(result) => CString::new(result).unwrap_or_default().into_raw(),
        Err(error) => CString::new(format!("Error: {error}"))
            .unwrap_or_default()
            .into_raw(),
    }
}

/// Helper function to free strings returned by [`greet_recipient`].
///
/// # Safety
///
/// The caller must ensure:
/// * `s` is either null or a pointer returned by [`greet_recipient`]
/// * the string is not used after being freed
/// * the string is not freed more than once
#[unsafe(no_mangle)]
pub unsafe extern "C" fn free_rust_string(s: *mut c_char) {
    if !s.is_null() {
        unsafe {
            drop(CString::from_raw(s));
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use std::ffi::CString;

    #[test]
    fn greets_recipient() {
        let input = CString::new("Ihsan").unwrap();
        let result = unsafe {
            let ptr = greet_recipient(input.as_ptr());
            let output = CStr::from_ptr(ptr).to_string_lossy().into_owned();
            free_rust_string(ptr);
            output
        };

        assert_eq!(result, "Hello, Ihsan! Welcome to {{ project_name }}.");
    }

    #[test]
    fn rejects_null_input() {
        let result = unsafe {
            let ptr = greet_recipient(std::ptr::null());
            let output = CStr::from_ptr(ptr).to_string_lossy().into_owned();
            free_rust_string(ptr);
            output
        };

        assert!(result.starts_with("Error: null pointer"));
    }

    #[test]
    fn rejects_invalid_utf8() {
        let bytes = [0xFF, 0, 0, 0];
        let result = unsafe {
            let ptr = greet_recipient(bytes.as_ptr().cast::<c_char>());
            let output = CStr::from_ptr(ptr).to_string_lossy().into_owned();
            free_rust_string(ptr);
            output
        };

        assert!(result.starts_with("Error: invalid UTF-8"));
    }
}
