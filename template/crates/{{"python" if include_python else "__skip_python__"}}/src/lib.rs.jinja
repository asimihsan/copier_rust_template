//! Python extension module for {{ project_name }}.

use pyo3::exceptions::PyValueError;
use pyo3::prelude::*;

use {{ project_slug_underscore }}_core as core;

/// Create a greeting message.
///
/// Args:
///     recipient (str): The recipient to greet.
///
/// Returns:
///     str: The rendered greeting message.
///
/// Raises:
///     `ValueError`: If the recipient is empty.
///
/// Example:
///
/// ```python
/// >>> import {{ project_slug_underscore }}
/// >>> {{ project_slug_underscore }}.greet("Ihsan")
/// 'Hello, Ihsan! Welcome to {{ project_name }}.'
/// ```
#[pyfunction]
fn greet(recipient: &str) -> PyResult<String> {
    core::greeting_message(recipient).map_err(|e| PyValueError::new_err(e.to_string()))
}

/// Python module for {{ project_name }}.
#[pymodule]
fn {{ project_slug_underscore }}(_py: Python<'_>, m: &Bound<'_, PyModule>) -> PyResult<()> {
    m.setattr("__version__", env!("CARGO_PKG_VERSION"))?;
    m.setattr("__all__", ["__version__", "greet"])?;
    m.setattr("__doc__", "Python bindings for {{ project_name }}.")?;

    m.add_function(wrap_pyfunction!(greet, m)?)?;

    Ok(())
}
